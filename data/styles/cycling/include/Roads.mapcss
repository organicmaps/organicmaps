/* Keep here changes of the base map style file only. */
@import("../../outdoors/include/Roads.mapcss");

/* ~~~~ CYCLING STYLE — ROADS OVERRIDES ~~~~~
   Google Maps-like cased lines: a continuous contrasting casing underneath,
   with a colored blue stroke centered on top. The casing always stays
   continuous; the stroke is solid / dashed / dotted to encode the
   infrastructure type.

   Two blue intensities share one hue: dedicated cycleways and protected tracks
   use the stronger @cycleway shade, while painted and shared lanes use
   @cycleway_road. */

/* De-emphasize motorways and trunks, including bridge and tunnel layers. */
line|z7-[highway=motorway],
line|z7-[highway=trunk],
line|z10-[highway=motorway_link],
line|z10-[highway=trunk_link],
{opacity: 0.4;}

line|z7-[highway=motorway]::bridgewhite,
line|z7-[highway=motorway]::bridgeblack,
line|z7-[highway=trunk]::bridgewhite,
line|z7-[highway=trunk]::bridgeblack,
line|z10-[highway=motorway_link]::bridgewhite,
line|z10-[highway=motorway_link]::bridgeblack,
line|z10-[highway=trunk_link]::bridgewhite,
line|z10-[highway=trunk_link]::bridgeblack,
{casing-opacity: 0.4;}

line|z7-[highway=motorway][tunnel?],
line|z7-[highway=trunk][tunnel?],
line|z10-[highway=motorway_link][tunnel?],
line|z10-[highway=trunk_link][tunnel?],
{opacity: 0.4; casing-opacity: 0.4;}

/* Dedicated cycleways and designated shared paths/footways render solid in the
   stronger @cycleway blue, with a continuous casing. */
line|z11-[highway=cycleway][hwtag!=yescar],
line|z12-[highway=path][bicycle=designated][hwtag!=yescar],
line|z13-[highway=footway][bicycle=designated][hwtag!=yescar],
{color: @cycleway; opacity: 1; dashes: none; linecap: round;
 casing-color: @cycleway_casing; casing-width: 1.5; casing-linecap: round;}

line|z11[highway=cycleway][hwtag!=yescar],
{width: 1.3;}
line|z12[highway=cycleway][hwtag!=yescar],
line|z12[highway=path][bicycle=designated][hwtag!=yescar],
{width: 1.5;}
line|z13[highway=cycleway][hwtag!=yescar],
line|z13[highway=path][bicycle=designated][hwtag!=yescar],
line|z13[highway=footway][bicycle=designated][hwtag!=yescar],
{width: 2.0;}
line|z14[highway=cycleway][hwtag!=yescar],
line|z14[highway=path][bicycle=designated][hwtag!=yescar],
line|z14[highway=footway][bicycle=designated][hwtag!=yescar],
{width: 2.3;}
line|z15[highway=cycleway][hwtag!=yescar],
line|z15[highway=path][bicycle=designated][hwtag!=yescar],
line|z15[highway=footway][bicycle=designated][hwtag!=yescar],
{width: 3.7;}
line|z16[highway=cycleway][hwtag!=yescar],
line|z16[highway=path][bicycle=designated][hwtag!=yescar],
line|z16[highway=footway][bicycle=designated][hwtag!=yescar],
{width: 4.9;}
line|z17[highway=cycleway][hwtag!=yescar],
line|z17[highway=path][bicycle=designated][hwtag!=yescar],
line|z17[highway=footway][bicycle=designated][hwtag!=yescar],
{width: 6.0;}
line|z18-[highway=cycleway][hwtag!=yescar],
line|z18-[highway=path][bicycle=designated][hwtag!=yescar],
line|z18-[highway=footway][bicycle=designated][hwtag!=yescar],
{width: 6.9;}

/* A separately mapped bicycle way with explicit motor-vehicle access is shared
   space, not protected infrastructure. Keep its normal visibility range while
   overriding the solid stroke with the dotted shared-space treatment. */
line|z11-[highway=cycleway][hwtag=yescar],
line|z12-[highway=path][bicycle=designated][hwtag=yescar],
line|z13-[highway=footway][bicycle=designated][hwtag=yescar],
{opacity: 1; linecap: round;
 casing-color: @cycleway_casing; casing-width: 1.5; casing-dashes: none; casing-linecap: round;}

line|z11[highway=cycleway][hwtag=yescar],
{color: @cycleway_road; width: 1.3; dashes: 1.3,2.7;}
line|z12[highway=cycleway][hwtag=yescar],
line|z12[highway=path][bicycle=designated][hwtag=yescar],
{color: @cycleway_road; width: 1.5; dashes: 1.5,3.1;}
line|z13[highway=cycleway][hwtag=yescar],
line|z13[highway=path][bicycle=designated][hwtag=yescar],
line|z13[highway=footway][bicycle=designated][hwtag=yescar],
{color: @cycleway_road; width: 2.0; dashes: 2.0,4.2;}
line|z14[highway=cycleway][hwtag=yescar],
line|z14[highway=path][bicycle=designated][hwtag=yescar],
line|z14[highway=footway][bicycle=designated][hwtag=yescar],
{color: @cycleway_road; width: 2.3; dashes: 2.4,4.8;}
line|z15[highway=cycleway][hwtag=yescar],
line|z15[highway=path][bicycle=designated][hwtag=yescar],
line|z15[highway=footway][bicycle=designated][hwtag=yescar],
{color: @cycleway_road; width: 3.7; dashes: 3.6,4.8;}
line|z16[highway=cycleway][hwtag=yescar],
line|z16[highway=path][bicycle=designated][hwtag=yescar],
line|z16[highway=footway][bicycle=designated][hwtag=yescar],
{color: @cycleway_road; width: 4.9; dashes: 4.5,5.1;}
line|z17[highway=cycleway][hwtag=yescar],
line|z17[highway=path][bicycle=designated][hwtag=yescar],
line|z17[highway=footway][bicycle=designated][hwtag=yescar],
{color: @cycleway_road; width: 6.0; dashes: 5.4,5.4;}
line|z18-[highway=cycleway][hwtag=yescar],
line|z18-[highway=path][bicycle=designated][hwtag=yescar],
line|z18-[highway=footway][bicycle=designated][hwtag=yescar],
{color: @cycleway_road; width: 6.9; dashes: 6.6,6.6;}

/* The base path/footway line is already solid @cycleway, so the inherited
   ::cycleline underline (a second, fainter blue line) is redundant. */
line|z12-[highway=path][bicycle=designated]::cycleline,
line|z13-[highway=footway][bicycle=designated]::cycleline,
{width: 0;}

/* Cycleway infrastructure attached to a road. Solid = track, dashed = lane,
   dotted = shared_lane, all in the same @cycleway_road blue over a continuous
   casing (the casing never inherits the stroke dashes). */
line|z13-[cyclewaytag=track],
line|z14-[cyclewaytag=lane],
line|z14-[cyclewaytag=shared_lane],
{opacity: 1; linecap: round;
 casing-color: @cycleway_casing; casing-width: 1.5; casing-dashes: none; casing-linecap: round;}

line|z13-[cyclewaytag=track],
{color: @cycleway;}

line|z14-[cyclewaytag=lane],
line|z14-[cyclewaytag=shared_lane],
{color: @cycleway_road;}

line|z13[cyclewaytag=track],
{width: 2.0;}
line|z14[cyclewaytag=track],
{width: 2.3;}
line|z15[cyclewaytag=track],
{width: 3.7;}
line|z16[cyclewaytag=track],
{width: 4.9;}
line|z17[cyclewaytag=track],
{width: 6.0;}
line|z18-[cyclewaytag=track],
{width: 6.9;}

line|z14[cyclewaytag=lane],
{width: 2.3; dashes: 12.12,2.98;}
line|z15[cyclewaytag=lane],
{width: 3.7; dashes: 19.5,4.8;}
line|z16[cyclewaytag=lane],
{width: 4.9; dashes: 21.75,5.1;}
line|z17[cyclewaytag=lane],
{width: 6.0; dashes: 24,5.4;}
line|z18-[cyclewaytag=lane],
{width: 6.9; dashes: 27,6.0;}

line|z14[cyclewaytag=shared_lane],
{width: 2.3; dashes: 2.4,4.8;}
line|z15[cyclewaytag=shared_lane],
{width: 3.7; dashes: 3.6,4.8;}
line|z16[cyclewaytag=shared_lane],
{width: 4.7; dashes: 4.5,5.1;}
line|z17[cyclewaytag=shared_lane],
{width: 5.7; dashes: 5.4,5.4;}
line|z18-[cyclewaytag=shared_lane],
{width: 6.6; dashes: 6.6,6.6;}
