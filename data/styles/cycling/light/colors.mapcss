/* Keep here changes of the base map style file only. */
@import("../../outdoors/light/colors.mapcss");

/* Cycling accent: one blue hue in two intensities.
   - @cycleway: dedicated cycleways and protected tracks (stronger).
   - @cycleway_road: painted and shared lanes.
   - @cycleway_casing: the continuous contrasting outline drawn underneath. */
@cycleway: #0D47A1;
@cycleway_road: #42A5F5;
@cycleway_casing: #FFFFFF;
@cycleway_arrow_solid_xs: cycling-arrow-solid-xs.svg;
@cycleway_arrow_solid_s: cycling-arrow-solid-s.svg;
@cycleway_arrow_solid_m: cycling-arrow-solid-m.svg;
@cycleway_arrow_patterned_xs: cycling-arrow-patterned-xs.svg;
@cycleway_arrow_patterned_s: cycling-arrow-patterned-s.svg;
@cycleway_arrow_patterned_m: cycling-arrow-patterned-m.svg;
/* Local quiet colored-road experiment. */
@trunk0: #ECBE9B;
@trunk1: #ECC09B;
@primary0: #ECC49B;
@primary1: #ECC8A3;
@primary2: #ECCDA7;
@secondary0: #ECD29B;
@secondary1: #ECD6A9;
@tertiary: #E9E8DE;
@residential: #E8E6DC;
@trunk_tunnel: #EBCDAE;
@primary_tunnel: #EBCDAE;
@secondary_tunnel: #ECD6A9;
