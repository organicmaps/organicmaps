/* Keep here changes of the base map style file only. */
@import("../../outdoors/light/colors.mapcss");

/* Single cycling accent: vivid cyan-blue. Geometry and width provide context
   while "blue means cycling" stays immediately recognizable. */
@cycleway: #1E88E5;
@cycleway_casing: #FFFFFF;
@cycleway_arrow_solid_xs: cycling-arrow-solid-xs.svg;
@cycleway_arrow_solid_s: cycling-arrow-solid-s.svg;
@cycleway_arrow_solid_m: cycling-arrow-solid-m.svg;
@cycleway_arrow_patterned_xs: cycling-arrow-patterned-xs.svg;
@cycleway_arrow_patterned_s: cycling-arrow-patterned-s.svg;
@cycleway_arrow_patterned_m: cycling-arrow-patterned-m.svg;
