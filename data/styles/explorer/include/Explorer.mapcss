/*
 * British Explorer — MapCSS prototype
 *
 * Experimental overrides for outdoor map rendering.
 * Review against the existing selectors before integration.
 */

/* Natural areas: calm, legible fills. */
area|z12-[leisure=park]
{
  color: #DCE8C9;
}

area|z12-[landuse=forest]
{
  color: #C5D8AE;
}

area|z12-[natural=wood]
{
  color: #B8CEA0;
}

area|z12-[natural=heath]
{
  color: #D9DCC0;
}

area|z12-[natural=grassland]
{
  color: #E5EBD8;
}

area|z12-[landuse=meadow]
{
  color: #DCE8C9;
}

/* Water: muted blue. */
area|z10-[natural=water]
{
  color: #A8CFDC;
}

area|z12-[waterway=riverbank]
{
  color: #A8CFDC;
}
