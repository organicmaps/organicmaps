    <string name="navigate_track_section_start">మార్గ భాగం ప్రారంభం</string>
    <!-- Destination when following a track forwards to the end of a section before a gap. -->
    <string name="navigate_track_section_finish">మార్గ భాగం ముగింపు</string>
    <!-- Track start point label. -->
    <string name="navigate_track_start">ట్రాక్ ప్రారంభం</string>
    <!-- Track finish point label. -->
    <string name="navigate_track_finish">ట్రాక్ ముగింపు</string>
</resources>
