    <string name="change_destination">గమ్యం మార్చు</string>
    <!-- Search field hint and full-screen map point picker title shown while replacing an already added intermediate stop of a route. Kept short because shortcut and voice-search buttons narrow the field -->
    <string name="change_stop_along_route">స్టాప్ మార్చు</string>
    <!-- Toast shown when the user tries to add one more intermediate stop to a route that already holds the maximum allowed number -->
    <string name="routing_max_stops_reached">గరిష్ట సంఖ్యలో స్టాప్‌లు చేరాయి</string>
    <!-- Hint under the title of the full-screen route point picker: a crosshair stays fixed in the centre of the screen while the user moves the map under it -->
    <string name="choose_point_on_map_hint">క్రాస్‌ను ఉంచడానికి మ్యాప్‌ను కదిలించండి మరియు జూమ్ చేయండి</string>
    <!-- Track recording notification button: stops the recording and saves the recorded track. -->
    <string name="track_recording_stop_and_save">ఆపి సేవ్ చేయండి</string>
    <!-- Track recording home screen widget button: opens the app to save or delete the recorded track. -->
    <string name="track_recording_finish">ముగించు</string>
    <!-- Accessibility label for the button that reverses the complete planned route, including intermediate stops. -->
    <string name="reverse_route">మార్గాన్ని వ్యతిరేక దిశలో మార్చండి</string>
    <!-- Error message in Editor when a user enters an invalid floor (level) of a place -->
    <string name="error_enter_correct_level">సరైన ఫ్లోర్ నంబర్‌ను నమోదు చేయండి</string>
    <!-- Hint for the floor (level) field in the place editor. In OpenStreetMap the ground floor is level 0, basements are negative -->
    <string name="editor_level">అంతస్తు (గ్రౌండ్ ఫ్లోర్ 0)</string>
    <!-- Start navigation along the selected track. -->
    <string name="navigate_track">నావిగేట్ చేయండి</string>
    <!-- Route planner label for the selected entry point on an unnamed track. -->
    <string name="navigate_track_entry">ఎంచుకున్న స్థానం</string>
