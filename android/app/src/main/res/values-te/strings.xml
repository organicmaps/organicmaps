    <string name="voice_search">వాయిస్ సెర్చ్</string>
    <!-- Accessibility label of the icon-only button beside the search field, shown while choosing or replacing a route point; it opens a full-screen map picker with a crosshair -->
    <string name="choose_on_map">మ్యాప్‌లో ఎంచుకోండి</string>
