    <string name="color_picker_red">ఎరుపు</string>
    <!-- Label for the green channel slider in the color picker -->
    <string name="color_picker_green">ఆకుపచ్చ</string>
    <!-- Label for the blue channel slider in the color picker -->
    <string name="color_picker_blue">నీలం</string>
