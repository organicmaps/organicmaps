    <string name="choose_start_location">ప్రారంభ స్థానం</string>
    <!-- Search field hint and full-screen map point picker title shown while choosing the destination of a route. Kept short because shortcut and voice-search buttons narrow the field -->
    <string name="choose_destination">గమ్యం</string>
