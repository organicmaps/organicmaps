<?xml version="1.0" encoding="utf-8"?>
<!-- Dims the icon and the label of a disabled contextual action together; setEnabled() alone leaves
     both at full strength. Also used by the toolbar navigation icon, which is never disabled. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item
    android:state_enabled="false"
    android:color="@color/black_38" />
  <item android:color="@color/text_dark" />
</selector>
