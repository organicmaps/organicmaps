<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="0dp"
  android:layout_height="match_parent"
  android:layout_margin="@dimen/margin_eighth"
  android:layout_marginEnd="@dimen/margin_base"
  android:layout_weight="1">

  <app.organicmaps.widget.RoutingProgressButton
    android:id="@+id/start"
    style="@style/MwmWidget.Button.Primary"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:text="@string/p2p_start"
    android:textColor="@color/start_button_text" />

  <LinearLayout
    android:id="@+id/water_progress_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:visibility="gone">

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/please_wait"
      android:textAppearance="?fontBody2" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
      android:id="@+id/water_progress"
      style="@style/Widget.MaterialComponents.LinearProgressIndicator"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/margin_eighth"
      android:contentDescription="@string/water_routing"
      android:indeterminate="true"
      app:indicatorColor="?colorAccent"
      app:indicatorDirectionLinear="startToEnd"
      app:trackColor="@color/bg_routing_progress" />
  </LinearLayout>
</FrameLayout>
