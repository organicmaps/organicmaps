<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:orientation="vertical"
  android:layout_width="match_parent"
  android:layout_height="match_parent">
  <androidx.appcompat.widget.Toolbar
    android:id="@+id/toolbar"
    style="@style/MwmWidget.ToolbarStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?colorPrimary"
    android:gravity="end|center_vertical"
    android:theme="@style/MwmWidget.ToolbarTheme"
    tools:ignore="UnusedAttribute">
  </androidx.appcompat.widget.Toolbar>
  <androidx.core.widget.NestedScrollView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1">
    <LinearLayout
      android:id="@+id/content"
      android:orientation="vertical"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="@dimen/margin_base">
      <TextView
        style="@style/MwmWidget.RoutingOptions.Header"
        android:text="@string/routing_options_all_modes"/>
      <com.google.android.material.card.MaterialCardView style="@style/MwmWidget.RoutingOptions.Card">
        <androidx.appcompat.widget.SwitchCompat
          android:id="@+id/route_optimization_btn"
          style="@style/MwmWidget.RoutingOptions.Row.Switch"
          android:text="@string/route_optimization"/>
      </com.google.android.material.card.MaterialCardView>
      <TextView
        style="@style/MwmWidget.RoutingOptions.Footer"
        android:text="@string/route_optimization_description"/>
      <RadioGroup
        android:id="@+id/router_types"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_base"
        android:layout_marginEnd="@dimen/margin_base"
        android:background="@drawable/routing_toolbar_pill_bg"
        android:padding="@dimen/routing_toolbar_pill_padding"
        android:theme="@style/ThemeOverlay.RoutingOptions.Tabs">
        <app.organicmaps.widget.RoutingToolbarButton
          android:id="@+id/vehicle"
          style="@style/MwmWidget.RoutingToolbarCell"
          android:button="@drawable/ic_car"
          android:contentDescription="@string/routing_options_driving"/>
        <app.organicmaps.widget.RoutingToolbarButton
          android:id="@+id/pedestrian"
          style="@style/MwmWidget.RoutingToolbarCell"
          android:button="@drawable/ic_pedestrian"
          android:contentDescription="@string/routing_options_walking"/>
        <app.organicmaps.widget.RoutingToolbarButton
          android:id="@+id/bicycle"
          style="@style/MwmWidget.RoutingToolbarCell"
          android:button="@drawable/ic_bike"
          android:contentDescription="@string/routing_options_cycling"/>
        <app.organicmaps.widget.RoutingToolbarButton
          android:id="@+id/transit"
          style="@style/MwmWidget.RoutingToolbarCell"
          android:button="@drawable/ic_transit"
          android:contentDescription="@string/public_transport"/>
      </RadioGroup>
      <com.google.android.material.card.MaterialCardView
        android:id="@+id/road_avoidance_options"
        style="@style/MwmWidget.RoutingOptions.Card"
        android:layout_marginTop="@dimen/margin_base">
        <LinearLayout style="@style/MwmWidget.RoutingOptions.Rows">
          <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/avoid_tolls_btn"
            style="@style/MwmWidget.RoutingOptions.Row.Switch"
            android:text="@string/avoid_tolls"/>
          <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/avoid_dirty_roads_btn"
            style="@style/MwmWidget.RoutingOptions.Row.Switch"
            android:text="@string/avoid_unpaved"/>
          <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/avoid_ferries_btn"
            style="@style/MwmWidget.RoutingOptions.Row.Switch"
            android:text="@string/avoid_ferry"/>
          <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/avoid_motorways_btn"
            style="@style/MwmWidget.RoutingOptions.Row.Switch"
            android:text="@string/avoid_motorways"/>
          <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/avoid_steps_btn"
            style="@style/MwmWidget.RoutingOptions.Row.Switch"
            android:text="@string/avoid_steps"/>
          <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/avoid_difficult_trails_btn"
            style="@style/MwmWidget.RoutingOptions.Row.Switch"
            android:text="@string/avoid_difficult_trails"/>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <LinearLayout
        android:id="@+id/bicycle_surface_options"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
          style="@style/MwmWidget.RoutingOptions.Header"
          android:text="@string/bicycle_surface"/>
        <com.google.android.material.card.MaterialCardView style="@style/MwmWidget.RoutingOptions.Card">
          <RadioGroup style="@style/MwmWidget.RoutingOptions.Rows">
            <RadioButton
              android:id="@+id/bicycle_surface_any"
              style="@style/MwmWidget.RoutingOptions.Row.Choice"
              android:text="@string/bicycle_surface_any"/>
            <RadioButton
              android:id="@+id/bicycle_surface_paved"
              style="@style/MwmWidget.RoutingOptions.Row.Choice"
              android:text="@string/bicycle_surface_prefer_paved"/>
            <RadioButton
              android:id="@+id/bicycle_surface_unpaved"
              style="@style/MwmWidget.RoutingOptions.Row.Choice"
              android:text="@string/bicycle_surface_prefer_unpaved"/>
            <RadioButton
              android:id="@+id/bicycle_surface_avoid_unpaved"
              style="@style/MwmWidget.RoutingOptions.Row.Choice"
              android:text="@string/avoid_unpaved"/>
          </RadioGroup>
        </com.google.android.material.card.MaterialCardView>
      </LinearLayout>
      <LinearLayout
        android:id="@+id/transit_mode_options"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
          style="@style/MwmWidget.RoutingOptions.Header"
          android:text="@string/transit_mode_options"/>
        <com.google.android.material.card.MaterialCardView style="@style/MwmWidget.RoutingOptions.Card">
          <LinearLayout
            android:id="@+id/transit_mode_rows"
            style="@style/MwmWidget.RoutingOptions.Rows"/>
        </com.google.android.material.card.MaterialCardView>
      </LinearLayout>
    </LinearLayout>
  </androidx.core.widget.NestedScrollView>
</LinearLayout>
