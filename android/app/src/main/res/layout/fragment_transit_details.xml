<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="?cardBackground"
  android:orientation="vertical">

  <include layout="@layout/toolbar_default" />

  <!-- The per-leg breakdown (board/exit stops + line badges), reusing TransitDetailsAdapter. This screen
       owns the scrolling, so unlike the old inline breakdown the list scrolls on its own. -->
  <androidx.recyclerview.widget.RecyclerView
    android:id="@+id/transit_details_recycler"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="@dimen/margin_base" />

</LinearLayout>
