<?xml version="1.0" encoding="utf-8"?>
<!-- Set or change the 6-digit PIN (PinDialog). The phone number is the autofill "username", so the
     password manager stores the pair. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical"
  android:paddingStart="@dimen/margin_base_plus"
  android:paddingTop="@dimen/margin_half"
  android:paddingEnd="@dimen/margin_base_plus">

  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/syria_pin_set_message"
    android:textAppearance="?android:textAppearanceSmall" />

  <EditText
    android:id="@+id/pin_dialog_phone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/margin_half"
    android:autofillHints="username"
    android:focusable="false"
    android:importantForAutofill="yes"
    android:inputType="phone"
    android:textDirection="ltr" />

  <com.google.android.material.textfield.TextInputLayout
    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/margin_half"
    android:hint="@string/syria_login_pin_hint"
    android:layoutDirection="ltr"
    app:endIconMode="password_toggle">

    <com.google.android.material.textfield.TextInputEditText
      android:id="@+id/pin_dialog_pin"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:autofillHints="password"
      android:importantForAutofill="yes"
      android:inputType="numberPassword"
      android:maxLength="6"
      android:textDirection="ltr" />
  </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
