<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/car_controls"
  android:layout_width="wrap_content"
  android:layout_height="wrap_content"
  android:gravity="center_vertical"
  android:orientation="horizontal">
  <!-- For the test drives, shown in debug builds only: marks in the log the moment the car was shown wrong at. -->
  <com.google.android.material.floatingactionbutton.FloatingActionButton
    android:id="@+id/flag_log"
    style="@style/MwmWidget.MapButton.Zoom"
    android:layout_marginEnd="@dimen/margin_half"
    android:visibility="gone"
    android:importantForAccessibility="no"
    app:srcCompat="@drawable/ic_flag_log" />
  <com.google.android.material.floatingactionbutton.FloatingActionButton
    android:id="@+id/reverse_direction"
    style="@style/MwmWidget.MapButton.Zoom"
    android:layout_marginEnd="@dimen/margin_half"
    app:srcCompat="@drawable/ic_reverse_direction"
    android:contentDescription="@string/nogps_reverse_direction" />
  <com.google.android.material.floatingactionbutton.FloatingActionButton
    android:id="@+id/manual_position"
    style="@style/MwmWidget.MapButton"
    app:srcCompat="@drawable/ic_manual_position"
    android:contentDescription="@string/nogps_manual_position" />
</LinearLayout>
