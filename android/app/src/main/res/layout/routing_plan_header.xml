<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/routing_types_header"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:layout_marginTop="@dimen/margin_half"
  android:orientation="horizontal"
  android:paddingStart="@dimen/routing_plan_horizontal_padding"
  android:paddingEnd="@dimen/routing_plan_horizontal_padding">

  <FrameLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center_vertical"
    android:layout_weight="1"
    android:background="@drawable/routing_toolbar_pill_bg"
    android:padding="@dimen/routing_toolbar_pill_padding">

    <RadioGroup
      android:id="@+id/route_type"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal">

      <app.organicmaps.widget.RoutingToolbarButton
        android:id="@+id/vehicle"
        style="@style/MwmWidget.RoutingToolbarCell"
        android:button="@drawable/ic_car"
        android:checked="true" />

      <app.organicmaps.widget.RoutingToolbarButton
        android:id="@+id/pedestrian"
        style="@style/MwmWidget.RoutingToolbarCell"
        android:button="@drawable/ic_pedestrian" />

      <app.organicmaps.widget.RoutingToolbarButton
        android:id="@+id/transit"
        style="@style/MwmWidget.RoutingToolbarCell"
        android:button="@drawable/ic_transit" />

      <app.organicmaps.widget.RoutingToolbarButton
        android:id="@+id/bicycle"
        style="@style/MwmWidget.RoutingToolbarCell"
        android:button="@drawable/ic_bike" />

      <app.organicmaps.widget.RoutingToolbarButton
        android:id="@+id/ruler"
        style="@style/MwmWidget.RoutingToolbarCell"
        android:button="@drawable/ic_ruler_route" />

      <!-- Track direction chip, shown while following a track (Transit and Ruler cells hide:
           tracks are followed with the vehicle/pedestrian/bicycle profiles only). The label is
           a language-neutral A→B/B→A glyph set from code; a tap reverses the direction. -->
      <TextView
        android:id="@+id/track_direction"
        style="@style/MwmWidget.RoutingToolbarCell"
        android:background="@drawable/routing_toolbar_chip"
        android:contentDescription="@string/reverse_track_direction"
        android:fontFamily="@string/robotoMedium"
        android:gravity="center"
        android:textColor="@color/routing_button_tint"
        android:textSize="@dimen/text_size_body_2"
        android:visibility="gone"
        tools:text="A→B"
        tools:visibility="visible" />
    </RadioGroup>

  </FrameLayout>

  <ImageButton
    android:id="@+id/back"
    android:layout_width="24dp"
    android:layout_height="24dp"
    android:layout_gravity="center_vertical"
    android:layout_marginStart="@dimen/margin_half_plus"
    android:layout_marginEnd="@dimen/margin_quarter"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:contentDescription="@string/close"
    android:scaleType="centerInside"
    app:srcCompat="@drawable/ic_close_rounded"
    app:tint="?iconTint" />

</LinearLayout>
