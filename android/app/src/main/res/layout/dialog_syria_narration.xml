<?xml version="1.0" encoding="utf-8"?>
<!-- A message read aloud with the spoken word highlighted (WelcomeNarrator), shown in a dialog. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="wrap_content">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/margin_base_plus"
    android:paddingTop="@dimen/margin_half"
    android:paddingEnd="@dimen/margin_base_plus">

    <TextView
      android:id="@+id/narration_text"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:lineSpacingMultiplier="1.25"
      android:textAppearance="?android:textAppearanceMedium"
      android:textColor="?android:textColorPrimary"
      tools:text="@string/syria_login_intro_message_en" />

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/margin_half"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <com.google.android.material.button.MaterialButton
        android:id="@+id/narration_play"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/syria_welcome_listen"
        android:textColor="?android:textColorPrimary"
        app:icon="@drawable/ic_voice_on"
        app:iconGravity="textStart"
        app:iconTint="?android:textColorPrimary"
        app:strokeColor="?android:textColorSecondary" />

      <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

      <com.google.android.material.button.MaterialButton
        android:id="@+id/narration_language"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/syria_language_en"
        android:textColor="?android:textColorPrimary" />
    </LinearLayout>
  </LinearLayout>
</ScrollView>
