<?xml version="1.0" encoding="utf-8"?>
<!-- Unlike the branded toolbar of the other bookmark screens, this one continues the ?cardBackground
     surface the card-grouped list sits on, and colours its contents from the theme rather than white. -->
<androidx.appcompat.widget.Toolbar
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/toolbar"
  style="@style/MwmWidget.Toolbar.BookmarkList"
  android:theme="@style/ThemeOverlay.Mwm.BookmarkListToolbar"
  android:layout_width="match_parent"
  android:layout_height="wrap_content">
  <include
    layout="@layout/toolbar_search_controls"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone"/>
</androidx.appcompat.widget.Toolbar>
