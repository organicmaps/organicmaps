  <!-- First-launch welcome on the map download screen. Both languages are kept here because the
       message can be read and played in either one, whatever the app language. -->
  <string name="syria_welcome_title">About this app</string>
  <string name="syria_welcome_listen">Listen</string>
  <string name="syria_welcome_stop">Stop</string>
  <string name="syria_welcome_no_voice">This phone has no %s voice installed. You can add one in Android settings → Text-to-speech output.</string>
  <string name="syria_welcome_maps_ready">The maps are ready. Tap the button below, or the map opens when the message ends.</string>
  <string name="syria_welcome_message_ar" translatable="false">أهلاً بك في تطبيق خرائط سوريا. يتيح لك هذا التطبيق التنقّل مجاناً في كل سوريا، حتى من دون إنترنت، باستخدام بيانات خريطة أوبن ستريت ماب سوريا. ندعوك إلى دعم المجتمع والمشاركة معنا: عندما تسجّل رحلاتك وتبحث في التطبيق، تساعدنا على فهم حركة التنقّل في سوريا وتحسين خريطة أوبن ستريت ماب سوريا للجميع. شكراً لمشاركتك! يجري الآن تنزيل خريطة العالم وخريطة سوريا.</string>
  <string name="syria_welcome_message_en" translatable="false">Welcome to Syria Organic Maps. This app lets you navigate all of Syria for free, even without internet, using OpenStreetMap Syria map data. We invite you to support the community and collaborate with us: when you record your trips and search in the app, you help us understand how people travel in Syria and improve the OpenStreetMap Syria map for everyone. Thank you for taking part! The world map and the Syria map are downloading now.</string>
  <string name="syria_language_ar" translatable="false">العربية</string>
  <string name="syria_language_en" translatable="false">English</string>
  <!-- On-screen guide of the main map (SyriaTutorial). -->
  <string name="syria_tutorial_help">Show the guide to this screen</string>
  <string name="syria_tutorial_step">%1$d of %2$d</string>
  <string name="syria_tutorial_next">Next</string>
  <string name="syria_tutorial_back">Back</string>
  <string name="syria_tutorial_skip">Skip</string>
  <string name="syria_tutorial_done">Done</string>
  <string name="syria_tutorial_dont_show">Don\'t show again</string>
  <string name="syria_tutorial_recording_title">Record your trip</string>
  <string name="syria_tutorial_recording_text">Red means you are not recording. Tap it to start recording your trip; it turns green while recording. Your trips help the community improve the Syria map.</string>
  <string name="syria_tutorial_internet_title">Internet</string>
  <string name="syria_tutorial_internet_text">Shows whether you are online. Recordings and searches are kept on the phone and sync when you are back online.</string>
  <string name="syria_tutorial_search_title">Search</string>
  <string name="syria_tutorial_search_text">Find places, streets and addresses. Search works without internet.</string>
  <string name="syria_tutorial_layers_title">Map styles and layers</string>
  <string name="syria_tutorial_layers_text">Switch to the outdoors style, or show subway, cycling and hiking layers.</string>
  <string name="syria_tutorial_zoom_title">Zoom</string>
  <string name="syria_tutorial_zoom_text">Zoom in and out. You can also pinch the map with two fingers.</string>
  <string name="syria_tutorial_position_title">My location</string>
  <string name="syria_tutorial_position_text">Shows where you are. Tap again to follow your direction.</string>
  <string name="syria_tutorial_bookmarks_title">Saved places</string>
  <string name="syria_tutorial_bookmarks_text">Your bookmarks and tracks.</string>
  <string name="syria_tutorial_menu_title">Menu</string>
  <string name="syria_tutorial_menu_text">Download maps, settings, activity recording, and sharing your location.</string>
  <string name="syria_tutorial_help_title">Help</string>
  <string name="syria_tutorial_help_text">Tap here any time to see this guide again.</string>
  <string name="syria_about_title">About Syria Organic Maps</string>
  <string name="syria_about_fork">This app is a fork of the open-source Organic Maps app, customised for Syria with local Syria OpenStreetMap data. It is developed and maintained by the OpenStreetMap Syria community.</string>
  <string name="syria_about_proposition_1">No ads. Your activity is recorded only when you start a recording.</string>
  <string name="syria_about_website">Website and privacy policy</string>
