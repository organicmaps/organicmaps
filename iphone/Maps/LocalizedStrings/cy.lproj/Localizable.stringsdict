<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

<!-- ********** Strings for downloading map from search **********/ -->

	<key>bookmarks_places</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>Dim nodau tudalen</string>
			<key>one</key>
			<string>%d nod tudalen</string>
			<key>two</key>
			<string>%d nod tudalen</string>
			<key>few</key>
			<string>%d nod tudalen</string>
			<key>many</key>
			<string>%d nod tudalen</string>
			<key>other</key>
			<string>%d nod tudalen</string>
		</dict>
	</dict>

	<key>bookmarks_detect_message</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>Ni chanfuwyd unrhyw ffeiliau.</string>
			<key>one</key>
			<string>Cafwyd hyd i %d ffeil. Gallwch ei gweld ar ôl ei throsi.</string>
			<key>two</key>
			<string>Cafwyd hyd i %d ffeil. Gallwch eu gweld ar ôl eu trosi.</string>
			<key>few</key>
			<string>Cafwyd hyd i %d ffeil. Gallwch eu gweld ar ôl eu trosi.</string>
			<key>many</key>
			<string>Cafwyd hyd i %d ffeil. Gallwch eu gweld ar ôl eu trosi.</string>
			<key>other</key>
			<string>Cafwyd hyd i %d ffeil. Gallwch eu gweld ar ôl eu trosi.</string>
		</dict>
	</dict>

	<key>tracks</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>Dim traciau</string>
			<key>one</key>
			<string>%d trac</string>
			<key>two</key>
			<string>%d drac</string>
			<key>few</key>
			<string>%d thrac</string>
			<key>many</key>
			<string>%d thrac</string>
			<key>other</key>
			<string>%d trac</string>
		</dict>
	</dict>

</dict>
</plist>