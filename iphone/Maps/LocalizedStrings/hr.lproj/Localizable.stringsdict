<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

<!-- ********** Strings for downloading map from search **********/ -->

	<key>bookmarks_places</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>%d zabilješki</string>
			<key>one</key>
			<string>%d zabilješka</string>
			<key>few</key>
			<string>%d zabilješke</string>
			<key>other</key>
			<string>%d zabilješki</string>
		</dict>
	</dict>

	<key>bookmarks_detect_message</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>Pronađeno je %d datoteka. Možeš ih vidjeti nakon konverzije.</string>
			<key>one</key>
			<string>Pronađena je %d datoteka. Možeš je vidjeti nakon konverzije.</string>
			<key>few</key>
			<string>Pronađene su %d datoteke. Možeš ih vidjeti nakon konverzije.</string>
			<key>other</key>
			<string>Pronađeno je %d datoteka. Možeš ih vidjeti nakon konverzije.</string>
		</dict>
	</dict>

<!-- Number of imported polygon areas (zones or regions) saved in a bookmark list, not their surface size. -->
	<key>areas</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d područje</string>
			<key>few</key>
			<string>%d područja</string>
			<key>other</key>
			<string>%d područja</string>
		</dict>
	</dict>

	<key>tracks</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>%d puteva</string>
			<key>one</key>
			<string>%d put</string>
			<key>few</key>
			<string>%d puta</string>
			<key>other</key>
			<string>%d puteva</string>
		</dict>
	</dict>


<!-- ********** gps strings **********/ -->

<!-- Number of stops ridden on a single transit line. -->
	<key>transit_stops_count</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d stanica</string>
			<key>few</key>
			<string>%d stanice</string>
			<key>other</key>
			<string>%d stanica</string>
		</dict>
	</dict>

</dict>
</plist>