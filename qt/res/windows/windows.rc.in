#include <winver.h>

IDI_ICON1 ICON DISCARDABLE "@OMIM_WINDOWS_ICON@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @OMIM_WINDOWS_VERSION_NUMBERS@
 PRODUCTVERSION @OMIM_WINDOWS_VERSION_NUMBERS@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Organic Maps\0"
      VALUE "FileDescription", "Organic Maps\0"
      VALUE "FileVersion", "@OMIM_WINDOWS_VERSION_STRING@\0"
      VALUE "InternalName", "OrganicMaps\0"
      VALUE "LegalCopyright", "Copyright 2020-2026 Organic Maps Contributors\0"
      VALUE "OriginalFilename", "OrganicMaps.exe\0"
      VALUE "ProductName", "Organic Maps\0"
      VALUE "ProductVersion", "@OMIM_WINDOWS_VERSION_STRING@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
