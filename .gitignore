# Please use android/.gitignore for all Android stuff

*~
.DS_Store
/screenlog.0
compile_commands.json

# Styles and colors edited by the built-in designer (see qt/build_style)
data/symbols/*/design/
data/drules_design.bin
data/colors_design.txt
data/patterns_design.txt
# User data written by the app (local OSM edits, bookmarks)
data/bookmarks
data/edits.xml
data/settings.ini
# Downloaded terrain blocks (see Storage::GetTerrainDir).
data/terrain/

# Python compiled files and dependencies
*.pyc
uv.lock

# Windows generated files
*.vcxproj*
*.sln
*.user
*.pdb
*.rc
!qt/res/windows/windows.rc
/out/

# XCode
xcode/keys/*
xcode/fastlane/report.xml
xcode/fastlane/README.md
iphone/*/*.xcodeproj/*.pbxuser
iphone/*/*.xcodeproj/project.xcworkspace/*
!iphone/*/*.xcodeproj/project.xcworkspace/xcshareddata/
**/DerivedData/*
**/xcuserdata
**/xcshareddata/swiftpm/
**/xcshareddata/IDEWorkspaceChecks.plist
iphone/**/*.moved-aside
iphone/**/*.swp
iphone/**/*.mode1v3
iphone/**/*.mode2v3
iphone/**/*.perspectivev3

# data
data/[0-9][0-9][0-9][0-9][0-9][0-9]
data/gps_track.dat
# custom raster background tiles disk cache
data/bg_tiles/
# JetBrains IDEs
.idea/
!/android/.idea/
/android/.idea/*
# Must stay here: git does not descend into an excluded directory, so android/.gitignore cannot re-include icon.svg
!/android/.idea/icon.svg

# Visual Studio
/.vs/

# VS Code
/.vscode/*
!/.vscode/extensions.json

# clangd
/.cache/

# Qt Designer
*.autosave

# Vim files
*.sw?

# CMake
/cmake-build-*
build/
/build*/
# Per-developer CMake preset overrides (CMakePresets.json is committed).
CMakeUserPresets.json

#python modules building
/tools/python/*/build
/tools/python/*/dist
/tools/python/*/*.egg-info
/tools/python/data/*/build
/tools/python/data/*/dist
/tools/python/data/*/*.egg-info
/tools/python/*/venv/

# Configs
/tools/python/maps_generator/var/etc/map_generator.ini
/tools/python/routing/etc/*.ini
/tools/unix/maps/settings.sh

# Helpers
/node_modules/
/package-lock.json

# AppStore metadata (Google Play listings are in android/app/.gitignore)
/screenshots/
/keywords/
/iphone/metadata/**/keywords.txt

# Local files that should not be tracked or committed
AGENTS.override.md
CLAUDE.local.md
plans

# Syria Organic Maps: release signing and private docs (never commit)
/Syria/keystore/
/Syria/dist/
/Syria/CONCEPT_NOTE.md
/Syria/screenshots/

# Third-party code is pinned by upstream Organic Maps (submodules and vendored files); local builds
# and experiments there are never committed. Submodule noise is also hidden locally with
# `git config submodule.<name>.ignore all` (set for every 3party submodule on this machine).
/3party/
tools/kothic

# Organic Maps CI workflows: kept on disk for reference, but not run by GitHub in this fork (they need Organic Maps'
# store keys or cover iOS/desktop). Our Android check is .github/workflows/syria-android.yaml.
/.github/workflows/android-beta.yaml
/.github/workflows/android-check-metadata.yaml
/.github/workflows/android-check.yaml
/.github/workflows/android-monkey.yaml
/.github/workflows/android-release-metadata.yaml
/.github/workflows/android-release.yaml
/.github/workflows/android-sdk-check.yaml
/.github/workflows/android-sdk.yaml
/.github/workflows/appstream-check.yaml
/.github/workflows/borders-check.yaml
/.github/workflows/build-cmake-mac.yaml
/.github/workflows/build-cmake.yaml
/.github/workflows/build-sailfish.yaml
/.github/workflows/code-style-check-kotlin.yaml
/.github/workflows/code-style-check-swift.yaml
/.github/workflows/code-style-check.yaml
/.github/workflows/desktop-file-check.yaml
/.github/workflows/detekt-check.yaml
/.github/workflows/drape-queue-stress-check.yaml
/.github/workflows/ios-beta.yaml
/.github/workflows/ios-check-metadata.yaml
/.github/workflows/ios-check.yaml
/.github/workflows/ios-release.yaml
/.github/workflows/strings-check.yaml
/.github/workflows/timezone-check.yaml
